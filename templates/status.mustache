{{!
    @template assignsubmission_refchecker/status

    The compact reference checking status shown in the submission status table and the grading
    table. Rendered once per grading table row, so it stays small.

    Context variables required for this template:
    * submissionid int - the submission this status belongs to
    * statuslabel string - the localised status line
    * inprogress bool - whether checking is still running
    * iscomplete bool - whether checking finished
    * isfailed bool - whether checking failed
    * isnorefs bool - whether no reference list was found
    * norefsguidance string - advice shown when no reference list was found
    * showcounts bool - whether to render any count badges
    * counts array - label, count and labelclass for each badge
    * showdiagnostics bool - whether to show the error code (teachers only)
    * errorcode string - machine readable failure code
    * errormessage string - human readable failure detail

    Example context (json):
    {
        "submissionid": 42,
        "statuslabel": "15 / 16 (94%) checks complete",
        "inprogress": true,
        "iscomplete": false,
        "isfailed": false,
        "isnorefs": false,
        "norefsguidance": "",
        "showcounts": true,
        "counts": [{"label": "References", "count": 16, "labelclass": "total"}],
        "showdiagnostics": false,
        "errorcode": "",
        "errormessage": ""
    }
}}
<div class="assignsubmission_refchecker-status" data-region="refchecker-status" data-submissionid="{{submissionid}}">
    <div role="status" aria-live="polite" class="assignsubmission_refchecker-statusline">
        {{#inprogress}}
            <span class="assignsubmission_refchecker-spinner" aria-hidden="true"></span>
        {{/inprogress}}
        <span class="assignsubmission_refchecker-statustext">{{statuslabel}}</span>
    </div>

    {{#showcounts}}
        <div class="assignsubmission_refchecker-counts">
            {{#counts}}
                <span class="assignsubmission_refchecker-summary-pill assignsubmission_refchecker-summary-pill-{{labelclass}}">{{count}} {{label}}</span>
            {{/counts}}
        </div>
    {{/showcounts}}

    {{#isnorefs}}
        <div class="assignsubmission_refchecker-guidance text-muted small">{{norefsguidance}}</div>
    {{/isnorefs}}

    {{#showdiagnostics}}
        <div class="assignsubmission_refchecker-diagnostics text-muted small">
            <code>{{errorcode}}</code>
            {{#errormessage}}<span>{{errormessage}}</span>{{/errormessage}}
        </div>
    {{/showdiagnostics}}
</div>
